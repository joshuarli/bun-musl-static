FROM ubuntu:24.04 AS build

ARG LLVM_VERSION=23.1.1
ARG LLVM_SHA256=3fbaaa6a1f147557a4095b9911f8dc2d4c745a11863982f76ee20e248c190a80
ARG LLVM_TAR=LLVM-23.1.1-Linux-ARM64.tar.xz
ARG ICU_SHA256=ac68372cf4a976e6a206858fd9b28c68e49d37d650b9b8653270038a6e7bc174
ARG ICU_URL=http://ports.ubuntu.com/ubuntu-ports/pool/main/i/icu/libicu70_70.1-2_arm64.deb
ARG APK_ARCH=aarch64
ARG TARGET_TRIPLE=aarch64-alpine-linux-musl
ARG BUN_ARCH=aarch64
ARG BUN_BOOTSTRAP_VERSION=1.4.4
ARG BUN_BOOTSTRAP_SHA256=baa6bb36f51d6e58561e02bbea825038a9df454f673d6d776e8bbf86f8c7850e
ARG BUN_LTO=on
ARG BUN_CAPTURE_ONLY=0
ARG RUST_NIGHTLY=nightly-2026-09-15
ARG BUN_GIT_SHA=0000000000000000000000000000000000000000

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      binutils build-essential ca-certificates ccache cmake curl file git \
      ninja-build perl pkg-config python3 unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

# LLVM's Linux release links lld against ICU 70.
RUN curl -fL --retry 5 -o /tmp/libicu.deb "$ICU_URL" \
    && echo "${ICU_SHA256}  /tmp/libicu.deb" | sha256sum -c - \
    && dpkg -i /tmp/libicu.deb \
    && rm /tmp/libicu.deb

RUN curl -fL --retry 5 -o /tmp/llvm.tar.xz \
      "https://github.com/llvm/llvm-project/releases/download/llvmorg-${LLVM_VERSION}/${LLVM_TAR}" \
    && echo "${LLVM_SHA256}  /tmp/llvm.tar.xz" | sha256sum -c - \
    && mkdir -p /opt/llvm \
    && tar -xJf /tmp/llvm.tar.xz -C /opt/llvm --strip-components=1 \
    && rm /tmp/llvm.tar.xz \
    && test -x /opt/llvm/bin/clang

RUN repo=https://dl-cdn.alpinelinux.org/alpine/v3.23/main \
    && curl -fL --retry 5 -o /tmp/APKINDEX.tar.gz "$repo/aarch64/APKINDEX.tar.gz" \
    && ver=$(tar -xzOf /tmp/APKINDEX.tar.gz APKINDEX | awk '/^P:apk-tools-static$/{f=1} f&&/^V:/{print substr($0,3); exit}') \
    && test -n "$ver" \
    && curl -fL --retry 5 -o /tmp/apk-tools.apk "$repo/aarch64/apk-tools-static-${ver}.apk" \
    && mkdir -p /tmp/apk-unpack \
    && tar -xzf /tmp/apk-tools.apk -C /tmp/apk-unpack sbin/apk.static \
    && /tmp/apk-unpack/sbin/apk.static --arch "$APK_ARCH" --root /opt/musl-sysroot --initdb \
      --allow-untrusted --no-cache \
      --repository "$repo" \
      --repository https://dl-cdn.alpinelinux.org/alpine/v3.23/community \
      add musl-dev g++ libstdc++-dev linux-headers \
    && gccdir=$(echo /opt/musl-sysroot/usr/lib/gcc/*-alpine-linux-musl/*) \
    && printf '%s\n' "--gcc-install-dir=${gccdir}" "-fuse-ld=lld" > "/opt/llvm/bin/${TARGET_TRIPLE}.cfg" \
    && printf '%s\n' "--gcc-install-dir=${gccdir}" "-fuse-ld=lld" > "/opt/llvm/bin/${TARGET_TRIPLE}-clang.cfg" \
    && printf '%s\n' "--gcc-install-dir=${gccdir}" "-fuse-ld=lld" > "/opt/llvm/bin/${TARGET_TRIPLE}-clang++.cfg" \
    && rm -rf /tmp/APKINDEX.tar.gz /tmp/apk-tools.apk /tmp/apk-unpack

ENV PATH=/opt/llvm/bin:/root/.cargo/bin:/usr/local/bin:$PATH \
    LINUX_MUSL_SYSROOT=/opt/musl-sysroot \
    CC=/opt/llvm/bin/clang \
    CXX=/opt/llvm/bin/clang++ \
    AR=/opt/llvm/bin/llvm-ar \
    RANLIB=/opt/llvm/bin/llvm-ranlib \
    LD=/opt/llvm/bin/ld.lld \
    LIBCLANG_PATH=/opt/llvm/lib \
    GIT_SHA=${BUN_GIT_SHA} \
    BUN_DEBUG_QUIET_LOGS=1

RUN set -eu; \
    printf '%s\n' '#include <iostream>' 'int main(){std::cout<<"ok\n";}' \
      | clang++ --target="$TARGET_TRIPLE" --sysroot=/opt/musl-sysroot \
        -stdlib=libstdc++ -static-libstdc++ -static-libgcc -static -fuse-ld=lld \
        -x c++ -o /tmp/static-cxx -; \
    test -z "$(readelf -l /tmp/static-cxx | grep INTERP || true)"; \
    test "$(/tmp/static-cxx)" = ok; \
    rm /tmp/static-cxx

WORKDIR /src
COPY . .

RUN curl -fL --retry 5 https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none \
    && rustup toolchain install "$RUST_NIGHTLY" --profile minimal \
      --component rust-src --component rustfmt --component llvm-tools \
    && rustup default "$RUST_NIGHTLY"

RUN curl -fL --retry 5 \
      "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_BOOTSTRAP_VERSION}/bun-linux-${BUN_ARCH}.zip" \
      -o /tmp/bun-bootstrap.zip \
    && echo "${BUN_BOOTSTRAP_SHA256}  /tmp/bun-bootstrap.zip" | sha256sum -c - \
    && unzip -q /tmp/bun-bootstrap.zip -d /tmp/bun-bootstrap \
    && install -m 0755 /tmp/bun-bootstrap/bun-linux-${BUN_ARCH}/bun /usr/local/bin/bun \
    && rm -rf /tmp/bun-bootstrap.zip /tmp/bun-bootstrap \
    && test "$(bun --version)" = "$BUN_BOOTSTRAP_VERSION"

RUN --mount=type=cache,id=bun-arm64-static-musl-cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=bun-arm64-static-musl-cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=bun-arm64-static-musl-build-llvm-23.1.1,target=/src/build \
    --mount=type=cache,id=bun-arm64-static-musl-ccache-llvm-23.1.1,target=/root/.cache/ccache \
    if [ "${BUN_CAPTURE_ONLY}" = "1" ]; then \
      bun run build:release --lto=${BUN_LTO} --abi=musl -j4 --configure-only \
      && set -- $(ninja -C build/release -t query bun-profile | sed -n '/^  input: link$/,/^  outputs:/p' | sed -n 's/^    //p') \
      && ninja -C build/release -j4 "$@"; \
    else \
      bun run build:release --lto=${BUN_LTO} --abi=musl -j4 \
      && file build/release/bun | grep -q 'statically linked' \
      && test -z "$(readelf -l build/release/bun | grep 'INTERP' || true)" \
      && test -z "$(readelf -d build/release/bun | grep 'NEEDED' || true)" \
      && ! ldd build/release/bun \
      && case "$(build/release/bun --version)" in \
           "${BUN_BOOTSTRAP_VERSION}"|"${BUN_BOOTSTRAP_VERSION}"-*) ;; \
           *) echo "unexpected bun version: $(build/release/bun --version)"; exit 1 ;; \
         esac \
      && test "$(build/release/bun -e 'console.log("ok")')" = "ok" \
      && cp build/release/bun /tmp/bun-release; \
    fi

FROM build AS capture

FROM alpine:3.23

COPY --from=build /tmp/bun-release /usr/local/bin/bun

RUN /usr/local/bin/bun --version \
    && test "$(/usr/local/bin/bun -e 'console.log("ok")')" = "ok"

ENTRYPOINT ["/usr/local/bin/bun"]
