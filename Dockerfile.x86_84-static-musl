FROM alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11 AS build

ARG LLVM_VERSION=23.1.0-rc2
ARG LLVM_ARCH=x86_64
ARG LLVM_RELEASE_SHA=6eb5fb9
ARG LLVM_SHA256=36647cca0bf57d206a6ce757d07a9d8489ef6ccf283a2cc7f740d1cba99a088b
# Bump when clang++.cfg or another compiler-wrapper contract changes.
ARG LLVM_TOOLCHAIN_REV=libstdcxx-static-4
ARG APK_ARCH=x86_64
ARG BUN_ARCH=x64
ARG BUN_BOOTSTRAP_VERSION=1.3.13
ARG BUN_BOOTSTRAP_SHA256=5b91a48f0b00df9fd2da8bff1a795d2659d842da966432969203f25da19d1c74
ARG BUN_LTO=on
ARG BUN_CAPTURE_ONLY=0
ARG RUST_NIGHTLY=nightly-2026-07-20
ARG BUN_GIT_SHA=0000000000000000000000000000000000000000

RUN apk add --no-cache \
    build-base \
    ca-certificates \
    ccache \
    cmake \
    curl \
    file \
    git \
    icu-dev \
    linux-headers \
    ninja \
    perl \
    rustup \
    unzip

# The prebuilt lld is intentionally zlib-free. Alpine's static libc, CRT, and
# compiler-runtime archives carry compressed debug sections, so strip those
# inputs before any host or target link consumes them.
RUN set -eu; \
    for obj in /usr/lib/*crt*.o /usr/lib/Scrt1.o /usr/lib/*.a /usr/lib/gcc/*/*/*.a; do \
        [ -e "$obj" ] || continue; \
        strip --strip-debug "$obj"; \
    done

# Alpine names the target-specific libstdc++ headers with its distro triple,
# while LLVM's target triple is x86_64-linux-musl.
RUN set -eu; \
    for inc in /usr/include/c++/*; do \
        [ -d "$inc" ] || continue; \
        src="$inc/${LLVM_ARCH}-alpine-linux-musl"; \
        dst="$inc/${LLVM_ARCH}-linux-musl"; \
        [ -d "$src" ] || continue; \
        [ -e "$dst" ] || ln -s "$(basename "$src")" "$dst"; \
    done

ADD https://github.com/laputa-systems/llvm-prebuilt-musl/releases/download/llvm-musl-${LLVM_VERSION}-${LLVM_RELEASE_SHA}/clang+llvm-${LLVM_VERSION}-${LLVM_ARCH}-linux-musl.tar.xz /tmp/llvm.tar.xz

RUN mkdir -p /opt/llvm-musl \
    && echo "${LLVM_SHA256}  /tmp/llvm.tar.xz" | sha256sum -c - \
    && tar xf /tmp/llvm.tar.xz -C /opt/llvm-musl --strip-components=1 \
    && rm /tmp/llvm.tar.xz \
    && test -f /opt/llvm-musl/lib/libclang.so \
    && printf '%s\n' '-stdlib=libstdc++' '-fuse-ld=lld' > /opt/llvm-musl/bin/clang++.cfg \
    && mv /opt/llvm-musl/bin/ld.lld /opt/llvm-musl/bin/ld.lld.real \
    && printf '%s\n' '#!/usr/bin/perl' '@ARGV = grep { $_ ne "--compress-debug-sections=zlib" } @ARGV;' 'exec { "/opt/llvm-musl/bin/ld.lld.real" } "ld.lld", @ARGV;' > /opt/llvm-musl/bin/ld.lld \
    && chmod 0755 /opt/llvm-musl/bin/ld.lld

ENV PATH=/opt/llvm-musl/bin:/root/.cargo/bin:/usr/local/bin:$PATH \
    CC=/opt/llvm-musl/bin/clang \
    CXX=/opt/llvm-musl/bin/clang++ \
    AR=/opt/llvm-musl/bin/llvm-ar \
    RANLIB=/opt/llvm-musl/bin/llvm-ranlib \
    LD=/opt/llvm-musl/bin/ld.lld \
    LIBRARY_PATH=/opt/llvm-musl/lib \
    LIBCLANG_PATH=/opt/llvm-musl/lib \
    CCACHE_DIR=/src/cache/ccache \
    CCACHE_BASEDIR=/src \
    CCACHE_COMPILERCHECK=content \
    CCACHE_EXTRAFILES=/opt/llvm-musl/bin/clang++.cfg \
    CCACHE_COMPRESS=true \
    CCACHE_MAXSIZE=20G \
    CCACHE_CC=/opt/llvm-musl/bin/clang \
    CCACHE_CXX=/opt/llvm-musl/bin/clang++ \
    GIT_SHA=${BUN_GIT_SHA} \
    BUN_LLVM_VERSION=${LLVM_VERSION} \
    BUN_DEBUG_QUIET_LOGS=1

# Fail early if the downloaded compiler cannot link the C and C++ runtime
# combinations used by the full build. This keeps toolchain failures out of
# the much slower Bun compilation step.
RUN set -eu; \
    printf '%s\n' 'int main(void) { return 0; }' \
      | clang -x c - -lunwind -o /tmp/clang-musl-c-smoke; \
    printf '%s\n' '#include <string>' 'int main() { return std::string(2, 120).size() != 2; }' \
      | clang++ -x c++ - -static-libstdc++ -static-libgcc -static -o /tmp/clang-musl-cxx-smoke; \
    /tmp/clang-musl-c-smoke; \
    /tmp/clang-musl-cxx-smoke; \
    rm /tmp/clang-musl-c-smoke /tmp/clang-musl-cxx-smoke

WORKDIR /src
COPY . .

RUN test "$(apk --print-arch)" = "${APK_ARCH}" \
    && rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
    && rustup toolchain install "$RUST_NIGHTLY" --profile minimal \
      --component rust-src --component rustfmt --component llvm-tools-preview \
    && rustup default "$RUST_NIGHTLY"

RUN curl -fsSL --retry 5 \
      "https://pub-5e11e972747a44bf9aaf9394f185a982.r2.dev/releases/bun-v${BUN_BOOTSTRAP_VERSION}/bun-linux-${BUN_ARCH}-musl.zip" \
      -o /tmp/bun-bootstrap.zip \
    && echo "${BUN_BOOTSTRAP_SHA256}  /tmp/bun-bootstrap.zip" | sha256sum -c - \
    && unzip -q /tmp/bun-bootstrap.zip -d /tmp/bun-bootstrap \
    && install -m 0755 /tmp/bun-bootstrap/bun-linux-${BUN_ARCH}-musl/bun /usr/local/bin/bun \
    && rm -rf /tmp/bun-bootstrap.zip /tmp/bun-bootstrap

# Build outputs and ccache entries are tied to the prebuilt compiler/config.
# Version these mounts so changing LLVM cannot reuse stale objects from an
# earlier toolchain; CCACHE_EXTRAFILES also covers clang++.cfg edits.
RUN --mount=type=cache,id=bun-x86_84-static-musl-cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=bun-x86_84-static-musl-cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=bun-x86_84-static-musl-build-${LLVM_RELEASE_SHA}-${LLVM_TOOLCHAIN_REV},target=/src/build \
    --mount=type=cache,id=bun-x86_84-static-musl-ccache-${LLVM_RELEASE_SHA}-${LLVM_TOOLCHAIN_REV},target=/src/cache \
    if [ "${BUN_CAPTURE_ONLY}" = "1" ]; then \
      bun run build:release --lto=${BUN_LTO} --configure-only \
      && set -- $(ninja -C build/release -t query bun-profile | sed -n '/^  input: link$/,/^  outputs:/p' | sed -n 's/^    //p') \
      && ninja -C build/release "$@"; \
    else \
      if ! bun run build:release --lto=${BUN_LTO} > /tmp/bun-build.log 2>&1; then \
        grep -n -E -C 8 'error:|Error:|FAILED|failed' /tmp/bun-build.log | tail -n 240 || true; \
        tail -n 120 /tmp/bun-build.log; \
        exit 1; \
      fi \
      && file build/release/bun | grep -q 'statically linked' \
      && test -z "$(readelf -l build/release/bun | grep 'INTERP' || true)" \
      && test -z "$(readelf -d build/release/bun | grep 'NEEDED' || true)" \
      && grep -Eq 'obj/vendor/mimalloc/src/.*static.c.o' build/release/bun-profile.linker-map \
      && llvm-nm -a build/release/bun-profile | grep -Eq '[[:space:]]mi_(malloc|calloc|realloc|free)([[:space:]]|$)' \
      && ! ldd build/release/bun 2>&1 \
      && build/release/bun --version \
      && test "$(build/release/bun -e 'console.log("ok")')" = "ok" \
      && test "$(build/release/bun -e 'console.log(40 + 2)')" = "42" \
      && build/release/bun -e 'const { heapStats } = require("bun:jsc"); const s = heapStats(); if (!s.mimalloc || s.mimalloc.mimalloc_version <= 3000 || s.mimalloc.pages.current <= 0 || s.mimalloc.committed.current <= 0) throw new Error("mimalloc stats missing"); const d = heapStats({ dump: true }); if (!d.mimallocDump?.heaps?.some(h => h.seq === 0 && h.pages?.length)) throw new Error("mimalloc heap dump missing");' \
      && cp build/release/bun /tmp/bun-release; \
    fi

FROM build AS capture

FROM alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11

COPY --from=build /tmp/bun-release /usr/local/bin/bun

RUN /usr/local/bin/bun --version \
    && ! apk info -e | grep -Eq '^(gcompat|glibc|libgcc|libstdc\\+\\+)' \
    && test "$(/usr/local/bin/bun -e 'console.log("ok")')" = "ok" \
    && test "$(/usr/local/bin/bun -e 'console.log(40 + 2)')" = "42" \
    && /usr/local/bin/bun -e 'const { heapStats } = require("bun:jsc"); const s = heapStats(); if (!s.mimalloc || s.mimalloc.mimalloc_version <= 3000 || s.mimalloc.pages.current <= 0 || s.mimalloc.committed.current <= 0) throw new Error("mimalloc stats missing");'

ENTRYPOINT ["/usr/local/bin/bun"]
